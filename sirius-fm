    # ----------------------------------------------------------------- helpers

    def show_error(self, message):
        self.banner.set_title(str(message))
        self.banner.set_revealed(True)
        return False

    def clear_error(self):
        self.banner.set_revealed(False)

    def update_freq_label(self):
        self.freq_label.set_label(f"{self.mhz:.1f} MHz")
        name = next((s["name"] for s in self.state["stations"]
                     if abs(s["mhz"] - self.mhz) < 0.05 and s.get("name")), "")
        self.name_label.set_label(name or " ")

    def persist(self):
        self.state["mhz"] = self.mhz
        save_state(self.state)

    # ----------------------------------------------------------------- outputs

    def refresh_outputs(self):
        def apply(outputs):
            if outputs != self.outputs:
                self.outputs = outputs
                self.build_output_rows()
            self.output_changed()
        in_thread(list_outputs, apply)

    def poll_outputs(self):
        self.refresh_outputs()
        return True

    def effective_output(self):
        """The saved choice if it can be used now, else the speaker."""
        usable = [o for o in self.outputs if o["usable"]]
        chosen = self.state["output"]
        match = next((o for o in usable if o["key"] == chosen), None)
        if match is None and chosen.startswith(BLUETOOTH):
            match = next((o for o in usable if o["kind"] == BLUETOOTH), None)
        if match is None:
            match = next((o for o in usable if o["key"] == SPEAKER), None)
        return match

    def build_output_rows(self):
        while (row := self.output_list.get_row_at_index(0)) is not None:
            self.output_list.remove(row)
        current = self.effective_output()
        group = None
        for out in self.outputs:
            check = Gtk.CheckButton(active=current is not None
                                    and out["key"] == current["key"])
            if group:
                check.set_group(group)
            else:
                group = check
            row = Adw.ActionRow(title=out["title"], subtitle=out["subtitle"],
                                sensitive=out["usable"])
            row.add_prefix(Gtk.Image(icon_name=OUTPUT_ICONS[out["kind"]]))
            row.add_suffix(check)
            row.set_activatable_widget(check)
            check.connect("toggled", self.on_output_toggled, out["key"])
            self.output_list.append(row)

    def on_output_toggled(self, check, key):
        if not check.get_active() or key == self.state["output"]:
            return
        self.state["output"] = key
        self.persist()
        self.output_popover.popdown()
        self.output_changed()

    def output_changed(self):
        """Show the output in use, and move playback to it if it changed."""
        current = self.effective_output()
        kind = current["kind"] if current else SPEAKER
        self.output_button.set_icon_name(OUTPUT_ICONS[kind])
        self.output_button.set_tooltip_text(
            "Output: " + (current["title"] if current else "none available"))
        sink = current["sink"] if current else None
        if self.player and sink and (sink != self.player_sink
                                     or kind != self.player_kind):
            self.restart_player()

    def on_audio_mode_toggled(self, check, key):
        if not check.get_active() or key == self.audio_mode:
            return
        self.audio_mode = key
        self.state["audio_mode"] = key
        self.persist()
        title = next(t for k, t, _ in AUDIO_MODES if k == key)
        self.audio_button.set_tooltip_text("Sound: " + title)
        if self.player:
            self.restart_player()

    # ----------------------------------------------------------------- stations

    def refresh_stations(self):
        while (row := self.station_list.get_row_at_index(0)) is not None:
            self.station_list.remove(row)
        for st in sorted(self.state["stations"], key=lambda s: s["mhz"]):
            row = Adw.ActionRow(title=st.get("name") or f"{st['mhz']:.1f} MHz",
                                subtitle=f"{st['mhz']:.1f} MHz", activatable=True)
            row.connect("activated", self.on_station_activated, st["mhz"])
            self.station_list.append(row)

    def on_station_activated(self, _row, mhz):
        self.stations_popover.popdown()
        self.tune(mhz, play=True)

    def update_scan_label(self):
        if self.scanning:
            text = "Scanning in the background… %d%%" % int(self.scan_progress * 100)
        elif self.state.get("scanned_at"):
            text = "Last scanned " + time.strftime(
                "%-d %b, %H:%M", time.localtime(self.state["scanned_at"]))
        else:
            text = "Not scanned yet"
        self.scan_label.set_label(text)
        self.progress.set_visible(self.scanning)
        self.progress.set_fraction(self.scan_progress)
        self.rescan_button.set_sensitive(not self.scanning)

    def start_scan(self):
        """Scan in the background; the saved list stays usable meanwhile."""
        if self.scanning or self.player:
            return
        self.scanning = True
        self.scan_progress = 0.0
        self.update_scan_label()

        def progress(obj):
            def show():
                self.scan_progress = obj["progress"]
                self.update_scan_label()
            GLib.idle_add(show)

        def done(result):
            self.scanning = False
            if not result.get("cancelled"):
                found = result["stations"]
                if found:
                    old = {round(s["mhz"], 1): s.get("name") for s in self.state["stations"]}
                    for st in found:
                        if not st.get("name") and old.get(round(st["mhz"], 1)):
                            st["name"] = old[round(st["mhz"], 1)]
                    self.state["stations"] = found
                    self.state["scanned_at"] = time.time()
                    self.refresh_stations()
                    self.update_freq_label()
                    self.persist()
                elif not self.state["stations"]:
                    self.show_error("No stations found. Plug in headphones: "
                                    "their lead is the aerial.")
                # the scan left the tuner on its last candidate
                in_thread(lambda: request("tune", mhz=self.mhz), self.apply_status)
            self.update_scan_label()

        def fail(e):
            self.scanning = False
            self.update_scan_label()
            self.show_error(e)

        in_thread(lambda: request("scan", stream=progress), done, fail)

    # ----------------------------------------------------------------- actions

    def tune(self, mhz, play=False):
        """Tune; the daemon stops a background scan to do it."""
        mhz = min(max(round(mhz, 1), 87.5), 108.0)
        self.mhz = mhz
        self.update_freq_label()

        def done(status):
            self.clear_error()
            self.apply_status(status)
            self.persist()
            if play and not self.player:
                self.start_audio()
            self.fetch_name(mhz)
        in_thread(lambda: request("tune", mhz=mhz), done, self.show_error)

    def fetch_name(self, mhz):
        def done(info):
            if abs(mhz - self.mhz) > 0.05 or not info.get("ps"):
                return
            match = next((s for s in self.state["stations"]
                          if abs(s["mhz"] - mhz) < 0.05), None)
            if match and match.get("name") != info["ps"]:
                match["name"] = info["ps"]
                self.refresh_stations()
                self.persist()
            self.name_label.set_label(info["ps"])
        in_thread(lambda: request("rds", seconds=3), done)

    def step_station(self, direction):
        freqs = sorted(s["mhz"] for s in self.state["stations"])
        if not freqs:
            self.tune(self.mhz + 0.1 * direction, play=bool(self.player))
            return
        if direction > 0:
            nxt = next((f for f in freqs if f > self.mhz + 0.05), freqs[0])
        else:
            nxt = next((f for f in reversed(freqs) if f < self.mhz - 0.05), freqs[-1])
        self.tune(nxt, play=bool(self.player))

    def apply_status(self, status):
        if status.get("scanning"):
            return                      # the tuner is sweeping, not on our station
        if not status.get("on"):
            self.level.set_value(0)
            self.signal_label.set_label("off")
            return
        rssi = status.get("rssi", -110)
        # map -105 dBm (noise) .. -55 dBm (strong) onto the bar
        self.level.set_value(min(max((rssi + 105) / 50, 0), 1))
        self.signal_label.set_label(f"{rssi} dBm")

    def poll(self):
        in_thread(lambda: request("status"), self.apply_status)
        return True

    def on_play(self, _button):
        if self.player:
            self.stop_audio()
        else:
            self.tune(self.mhz, play=True)

    def start_audio(self):
        if self.player:
            return
        if not mixer_available():
            self.show_error("Tuning works, but FM audio needs the internal FM "
                            "capture front end: flash boot-sirius-fm2.img")
            return
        output = self.effective_output()
        if not output:
            self.show_error("There is no output to play on")
            return
        try:
            request("audio", on=True)
        except DaemonError as e:
            self.show_error(e)
            return
        self.clear_error()
        set_mixer(True)
        self.spawn_player(output["sink"])
        self.play_button.set_icon_name("media-playback-stop-symbolic")
        self.play_button.set_tooltip_text("Stop")

    def spawn_player(self, sink):
        # The jack and the speakers share a PCM, so which one plays is a
        # matter of routing, applied here and undone when playback stops.
        kind = (self.effective_output() or {}).get("kind", SPEAKER)
        if have_headphone_codec():
            apply_route(HEADPHONE_ROUTE if kind == HEADPHONES else SPEAKER_ROUTE)
        command = build_pipeline(
            fm_capture_device(),
            "--device=" + shlex.quote(sink) if sink else "",
            self.audio_mode)
        self.player = subprocess.Popen(["sh", "-c", command],
                                       start_new_session=True)
        self.player_sink = sink
        self.player_kind = kind
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, self.player.pid,
                             self.on_player_exit, self.player)

    def kill_player(self):
        player, self.player = self.player, None
        self.player_sink = None
        self.player_kind = None
        if player:
            try:
                os.killpg(player.pid, 15)
            except ProcessLookupError:
                pass

    def restore_speaker_route(self):
        """Put the card back on the speakers when this app stops using it."""
        if have_headphone_codec():
            apply_route(SPEAKER_ROUTE)

    def restart_player(self):
        """Move playback to the output in use; the tuner and route stay up."""
        output = self.effective_output()
        self.kill_player()
        if output:
            self.spawn_player(output["sink"])

    def on_player_exit(self, _pid, status, player):
        if self.player is not player:
            return  # replaced by a restart, or stopped on purpose
        self.player = None
        self.player_sink = None
        self.player_kind = None
        set_mixer(False)
        self.restore_speaker_route()
        self.play_button.set_icon_name("media-playback-start-symbolic")
        self.play_button.set_tooltip_text("Play")
        if status:
            self.show_error("Audio stopped: the FM capture route failed to start")

    def stop_audio(self):
        if not self.player:
            return
        self.kill_player()
        set_mixer(False)
        self.restore_speaker_route()
        in_thread(lambda: request("audio", on=False))
        self.play_button.set_icon_name("media-playback-start-symbolic")
        self.play_button.set_tooltip_text("Play")

    def on_close(self, *_):
        self.stop_audio()
        self.persist()
        try:
            request("power", on=False)      # also stops a background scan
        except DaemonError:
            pass
        return False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == "__main__":
    raise SystemExit(App().run(None))
