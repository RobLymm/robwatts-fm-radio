"""FM Radio for the Sony Xperia Z2 on Phosh.

Tuning, scanning and RDS go through sirius-fmd, which owns the Broadcom tuner.
Audio is captured from the card's FM port and played to the sound server, on
the output chosen with the button at the top right: the speaker, a connected
Bluetooth device, or headphones once the headphone codec has a driver.

The station list is refreshed by a scan in the background each time the app
opens. The previous list stays usable meanwhile, and is only replaced when the
new scan finds stations, so opening the app without the headphone lead (the
aerial) plugged in does not wipe it.
"""
import json
import os
import shlex
import shutil
import socket
import subprocess
import threading
import time

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.sirius.FmRadio"
SOCK_PATH = "/run/sirius-fm/sirius-fm.sock"
STATE_DIR = os.path.join(GLib.get_user_data_dir(), "sirius-fm")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
# FM capture has its own front end, MultiMedia2: MultiMedia1 is held open for
# speaker playback and its route cannot be shared. The tuner's I2S arrives on
# the secondary MI2S pads, so the back end is SEC_MI2S_TX.
MIXER = "MultiMedia2 Mixer SEC_MI2S_TX"
CARD = os.environ.get("SIRIUS_FM_CARD", "0")
# Audio processing modes, chosen from the header. Mono and noise reduction are
# what a hardware radio does on a weak signal; kept optional so they can be
# compared on air (different locations, aerial length).
NR, MONO, STEREO = "nr", "mono", "stereo"
AUDIO_MODES = [
    (NR, "Noise reduction", "Mono, high frequencies rolled off"),
    (MONO, "Mono", "Both channels summed, full range"),
    (STEREO, "Stereo", "Raw capture, no processing"),
]
AUDIO_ICON = "audio-x-generic-symbolic"


def have_filter():
    return shutil.which("sirius-fm-downmix") is not None


FMREPAIR_PLUGIN = "/usr/lib/alsa-lib/libasound_module_pcm_fmrepair.so"


def capture_pcm(device):
    """ALSA PCM to read FM audio from.

    The port's fmrepair ALSA plugin (drivers/audio/fmrepair) exposes the raw
    MultiMedia2 capture as "sirius_fm" with the tuner's periodic I2S burst
    corruption repaired at the device layer, so every client gets clean audio.
    Fall back to the raw device when the plugin is not installed.
    """
    if os.path.exists(FMREPAIR_PLUGIN):
        return f"sirius_fm:CARD={CARD},DEV={device}"
    return f"hw:{CARD},{device}"


def build_pipeline(device, sink, mode):
    dev = capture_pcm(device)
    src = f"exec arecord -q -D {dev} -f S16_LE -r 48000 -c 2 -t raw"
    tail = f"pacat --playback --format=s16le --rate=48000 {sink} " \
           "--client-name='Robwatts Radio' --stream-name='Robwatts Radio'"
    if mode == STEREO or not have_filter():
        return f"{src} | {tail} --channels=2"
    flags = " --no-lowpass" if mode == MONO else ""
    return f"{src} | sirius-fm-downmix{flags} | {tail} --channels=1"

SPEAKER, HEADPHONES, BLUETOOTH = "speaker", "headphones", "bluetooth"
OUTPUT_ICONS = {
    SPEAKER: "audio-speakers-symbolic",
    HEADPHONES: "audio-headphones-symbolic",
    BLUETOOTH: "bluetooth-active-symbolic",
}


# --------------------------------------------------------------- daemon link

class DaemonError(Exception):
    pass


def request(cmd, stream=None, **kw):
    """Send one request; for streaming replies call stream(obj) per line."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK_PATH)
    except OSError as e:
        raise DaemonError("The FM tuner service is not running") from e
    with s, s.makefile("rw") as f:
        f.write(json.dumps({"cmd": cmd, **kw}) + "\n")
        f.flush()
        for line in f:
            obj = json.loads(line)
            if "progress" in obj and stream:
                stream(obj)
                continue
            if not obj.get("ok"):
                raise DaemonError(obj.get("error", "tuner error"))
            return obj
    raise DaemonError("The FM tuner service closed the connection")


def in_thread(work, done=None, fail=None):
    def run():
        try:
            result = work()
        except Exception as e:  # noqa: BLE001 - shown to the user
            if fail:
                GLib.idle_add(fail, e)
            return
        if done:
            GLib.idle_add(done, result)
    threading.Thread(target=run, daemon=True).start()


# --------------------------------------------------------------------- audio

def fm_capture_device():
    """Device number of the MultiMedia2 capture PCM, or None.

    Found by name: the number follows the order of the sound card's links in
    the device tree. The PCM only exists when the device tree declares the
    MultiMedia2 front end.
    """
    try:
        with open("/proc/asound/pcm") as f:
            lines = f.readlines()
    except OSError:
        return None
    for line in lines:
        ids, _, rest = line.partition(":")
        card, _, dev = ids.partition("-")
        if (card.isdigit() and int(card) == int(CARD) and dev.isdigit()
                and rest.strip().startswith("MultiMedia2") and "capture" in rest):
            return int(dev)
    return None


def mixer_available():
    if fm_capture_device() is None:
        return False
    r = subprocess.run(["amixer", "-c", CARD, "cget", f"name={MIXER}"],
                       capture_output=True)
    return r.returncode == 0


def set_mixer(on):
    subprocess.run(["amixer", "-q", "-c", CARD, "cset", f"name={MIXER}",
                    "1" if on else "0"], capture_output=True)


# The headphone jack and the loudspeakers are the same PCM with different
# routing. There is no UCM device for the jack: PulseAudio turns two UCM
# devices that share a PCM into two card profiles rather than two ports, and
# switching profile drops the sink. So the route is set here instead.
#
# Everything from "SLIM RX1 MUX" onwards is inside the WCD9320 codec. The
# codec's own muxes have to be pointing at the SLIMbus port before the
# routing mixer is switched on, or the DSP refuses to start the port.
HEADPHONE_ROUTE = [
    ("QUAT_MI2S_RX Audio Mixer MultiMedia1", "0"),
    ("SLIM RX1 MUX", "AIF1_PB"),
    ("SLIM RX2 MUX", "AIF1_PB"),
    ("RX1 MIX1 INP1", "RX1"),
    ("RX2 MIX1 INP1", "RX2"),
    ("CLASS_H_DSM MUX", "DSM_HPHL_RX1"),
    ("HPHL DAC Switch", "1"),
    ("HPHL Volume", "19"),
    ("HPHR Volume", "19"),
    ("SLIMBUS_0_RX Audio Mixer MultiMedia1", "1"),
]

SPEAKER_ROUTE = [
    ("SLIMBUS_0_RX Audio Mixer MultiMedia1", "0"),
    ("HPHL DAC Switch", "0"),
    ("CLASS_H_DSM MUX", "ZERO"),
    ("SLIM RX1 MUX", "ZERO"),
    ("SLIM RX2 MUX", "ZERO"),
    ("QUAT_MI2S_RX Audio Mixer MultiMedia1", "1"),
]


def control_exists(name):
    r = subprocess.run(["amixer", "-c", CARD, "cget", f"name={name}"],
                       capture_output=True)
    return r.returncode == 0


def have_headphone_codec():
    """True when the WCD9320 codec is present, so the jack can be driven."""
    return control_exists("HPHL DAC Switch")


def apply_route(route):
    for name, value in route:
        subprocess.run(["amixer", "-q", "-c", CARD, "cset", f"name={name}", value],
                       capture_output=True)


def list_outputs():
    """The outputs to offer, as dicts with key, kind, title, subtitle, sink, usable.

    Bluetooth appears once, greyed, when no audio device is connected, and as
    one entry per connected device otherwise. Headphones are greyed when the
    WCD9320 codec is not loaded. Nothing detects whether anything is actually
    plugged into the jack: the codec's jack detection is not driven yet.
    """
    try:
        out = subprocess.run(["pactl", "-f", "json", "list", "sinks"],
                             capture_output=True, text=True, timeout=5).stdout
        sinks = json.loads(out or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        sinks = []

    def api(s):
        props = s.get("properties", {})
        if props.get("device.api") == "bluez" or s.get("name", "").startswith("bluez_"):
            return "bluez"
        return props.get("device.api", "")

    speaker = next((s for s in sinks if api(s) == "alsa"), None)
    outputs = [{
        "key": SPEAKER, "kind": SPEAKER, "title": "Speaker",
        "subtitle": "" if speaker else "The sound server has no speaker output",
        "sink": speaker["name"] if speaker else None,
        "usable": speaker is not None,
    }, {
        "key": HEADPHONES, "kind": HEADPHONES, "title": "Headphones",
        "subtitle": "" if have_headphone_codec()
                    else "Not available: the headphone codec is not loaded",
        # Same sink as the speaker; only the routing differs.
        "sink": speaker["name"] if speaker else None,
        "usable": speaker is not None and have_headphone_codec(),
    }]
    bluetooth = [s for s in sinks if api(s) == "bluez"]
    for s in bluetooth:
        outputs.append({
            "key": BLUETOOTH + ":" + s["name"], "kind": BLUETOOTH,
            "title": s.get("description") or "Bluetooth", "subtitle": "Bluetooth",
            "sink": s["name"], "usable": True,
        })
    if not bluetooth:
        outputs.append({
            "key": BLUETOOTH, "kind": BLUETOOTH, "title": "Bluetooth",
            "subtitle": "No device connected", "sink": None, "usable": False,
        })
    return outputs


# ---------------------------------------------------------------------- state

def load_state():
    try:
        with open(STATE_FILE) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    state.setdefault("mhz", 98.9)
    state.setdefault("stations", [])
    state.setdefault("output", SPEAKER)
    return state


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1)
    os.replace(tmp, STATE_FILE)


